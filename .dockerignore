# Build output
**/bin/
**/obj/
Logs/

# Local configuration: connection strings and real addresses never leave the machine.
# appsettings.Development.json and appsettings.Production.json stay: they are in the
# repository, they are empty on purpose, and the build refuses to run without them
**/appsettings.Local.json
Deploy/**/.env

# Working files of the agents
.claude/
.codex/
.vs/
.idea/

# Materials derived from the proprietary files of the rights holder. They are in .gitignore
# for the same reason and have no business inside an image either
Pc.h
Data/
Utilities/Dump/
Utilities/DumpAndParserPackets/Dump5108.json
Utilities/DumpAndParserPackets/Monsters.json
Utilities/DumpAndParserPackets/NPCs.json

# Not needed to build the servers
Sites/
.git/
