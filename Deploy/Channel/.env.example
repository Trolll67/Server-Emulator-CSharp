# Address this channel is registered under in FNLParm.TblParmSvr (mMajorIp of the row with
# mType = 0). The row is looked up by it, and the listen port comes out of that row
CHANNEL_REGISTERED_IP=127.0.0.1

# Port to publish. It has to be the mTcpPort of the same row
CHANNEL_PORT=11004

# Name of the docker network the database container is on
SQL_NETWORK=sql_net

# How to reach the databases. The host part is the name of the database container, so the
# traffic stays inside the docker network
ACCOUNT_CONNECTION=Server=sqlserver,1433;Database=FNLAccount;User Id=sa;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True
PARM_CONNECTION=Server=sqlserver,1433;Database=FNLParm;User Id=sa;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True
