{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm} [{Level}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File", // RollingFile
        "Args": {
          "rollingInterval": "Day",
          "path": "Logs//Logging.txt",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  // Directory with the DSN files of the original server (Account.dsn, Game.dsn, Parm.dsn).
  // Credentials live there and are never copied into the repository.
  // Override locally with appsettings.Local.json or the environment variable
  // FnlDatabase__DsnDirectory
  "FnlDatabase": {
    "DsnDirectory": ""
  },
  "GameSetting": {
    "Id": 100,
    "ServerIp": "127.0.0.1",
    "ServerPort": 11007,

    "GarbageItems": 100000,
    "GarbageUnits": 30000,

    "RecoveryCharacteristics": 10000,

    "VisibleConnections": 2250,
    "VisibleItems": 2250,
    "VisibleUnits": 2250,

    "ItemPickUpDistance": 400
  }
}