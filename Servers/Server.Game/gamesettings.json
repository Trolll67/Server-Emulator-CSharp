{
  "GameSetting": {
    "Id": 100,
    // Адрес прослушивания; он же ключ, по которому поле ищется в TblParmSvr.
    // Порт берётся только из TblParmSvr.mTcpPort, в конфиге его нет
    "ServerIp": "127.0.0.1",

    // Шифровать ли исходящие пакеты: включено - crypt-байт 0x01 и тело кадра под тем же
    // поточным шифром, что и на приёме; welcome-пакет уходит открытым в любом случае, он же
    // и несёт клиенту ключевой блок. По умолчанию выключено - живой клиент принимает
    // открытый текст, а приёмка шифрования на нём ещё не пройдена: возможно, для направления
    // сервер -> клиент нужен ключ из welcome-блока, а не статический
    "EncryptOutgoingPackets": false,

    "GarbageItems": 100000,
    "GarbageUnits": 30000,

    "RecoveryCharacteristics": 10000,

    "VisibleConnections": 3000,
    "VisibleItems": 3000,
    "VisibleUnits": 3000,

    "ItemPickUpDistance": 400,

    // Порог перемещения за один пакет, в единицах карты. Допустимы значения [500, 10000),
    // любое другое значение (в том числе отсутствие настройки) даёт 500 — как в оригинале.
    // Второй порог, «телепорт через карту» (2000 единиц), в оригинале не настраивается
    // и живёт константой MoveSystem.MaxDistancePerMove
    "MoveMaxDistancePerTick": 500,

    "SavePcsEverySeconds":  5,

    // Периоды фоновых заданий планировщика, значение всегда в миллисекундах. Без ключа задание
    // работает со своим значением по умолчанию: GarbageItems, GarbageUnits, VisibleConnections,
    // VisibleItems, VisibleUnits, RespawnUnits — 100 мс, SaveCharacters — SavePcsEverySeconds
    "JobIntervals": {
      // "VisibleConnections": 100
    },

    // Стартовые карта и позиция при создании персонажа.
    // Карта 1 — остров Гвинея. Классы Magician и Summoner в оригинале стартуют на острове
    // Аккра (карта 80), но только когда включён соответствующий контент; при выключенном
    // они используют ту же точку, что и Assassin
    "StartPositions": [
      { "Class": "Knight",   "Map": 1, "X": 687549.0, "Y": 13532.0, "Z": 10135.0 },
      { "Class": "Ranger",   "Map": 1, "X": 744354.0, "Y": 22297.0, "Z": 60433.0 },
      { "Class": "Magician", "Map": 1, "X": 696802.0, "Y": 12019.0, "Z": 113712.0 },
      { "Class": "Assassin", "Map": 1, "X": 696802.0, "Y": 12019.0, "Z": 113712.0 },
      { "Class": "Summoner", "Map": 1, "X": 696802.0, "Y": 12019.0, "Z": 113712.0 }
    ]
  }
}