{
  "GameSetting": {
    "Id": 100,
    // Адрес прослушивания; он же ключ, по которому поле ищется в TblParmSvr.
    // Порт берётся только из TblParmSvr.mTcpPort, в конфиге его нет
    "ServerIp": "127.0.0.1",

    // Сколько игроков держит сервер. Уходит каналу в пакете состояния, а канал по нему
    // рисует клиенту заполненность сервера в списке
    "MaxSessions": 1000,

    // Как часто, в секундах, сервер зовёт каналы своего мира: упавшая связь поднимается
    // заново, живая получает пинг и состояние сервера
    "FamilyKeepAliveSeconds": 30,

    // Сборка, которой сервер представляется каналу при входе в мир
    "FamilyVersion": 0,

    // Шифровать ли исходящие пакеты: включено - crypt-байт 0x01 и тело кадра под тем же
    // поточным шифром, что и на приёме; welcome-пакет уходит открытым в любом случае, он же
    // и несёт клиенту ключевой блок. По умолчанию выключено - живой клиент принимает
    // открытый текст, а приёмка шифрования на нём ещё не пройдена: возможно, для направления
    // сервер -> клиент нужен ключ из welcome-блока, а не статический
    "EncryptOutgoingPackets": false,

    // Генерировать ли ключевой блок welcome-пакета: включено - блок той же длины и раскладки,
    // но с новой ключевой частью на каждое подключение. По умолчанию выключено - живой клиент
    // видел только заготовленный блок, а приёмка генерации на нём ещё не пройдена
    "GenerateSessionKey": false,

    // Время жизни вещи, лежащей в мире, в миллисекундах: десять минут, как в оригинале.
    // Отлежавшая своё вещь пропадает и из мира, и из базы. Сокращение времени жизни, когда
    // вещей в мире накопилось слишком много, не воспроизводим - вещь всегда лежит полный срок
    "GarbageItems": 600000,
    "GarbageUnits": 30000,

    "RecoveryCharacteristics": 10000,

    "VisibleConnections": 3000,
    "VisibleItems": 3000,
    "VisibleUnits": 3000,

    "ItemPickUpDistance": 400,

    // Порог перемещения за один пакет, в единицах карты. Допустимы значения [500, 10000),
    // любое другое значение (в том числе отсутствие настройки) даёт 500 — как в оригинале.
    // Второй порог, «телепорт через карту» (2000 единиц), в оригинале не настраивается
    // и живёт константой MoveSystem.MaxDistancePerMove
    "MoveMaxDistancePerTick": 500,

    "SavePcsEverySeconds":  5,

    // Штраф опыта при смерти персонажа, в процентах от накопленного на текущем уровне.
    // Допустимы значения [0, 100], любое другое даёт 2 — как было зашито в код
    "DeathExpPenaltyPercent": 2,

    // Периоды фоновых заданий планировщика, значение всегда в миллисекундах. Без ключа задание
    // работает со своим значением по умолчанию: GarbageItems, GarbageUnits, VisibleConnections,
    // VisibleItems, VisibleUnits, RespawnUnits — 100 мс, SaveCharacters — SavePcsEverySeconds
    "JobIntervals": {
      // "VisibleConnections": 100
    },

    // Стартовые карта и позиция при создании персонажа.
    // Карта 1 — остров Гвинея. Классы Magician и Summoner в оригинале стартуют на острове
    // Аккра (карта 80), но только когда включён соответствующий контент; при выключенном
    // они используют ту же точку, что и Assassin
    // Каталог со слоями регионов оригинального сервера (файлы "territory <x> <z>.bmp").
    // Это данные правообладателя, в репозитории их нет: путь указывает на каталог Data
    // оригинала. Пусто - территория точки неизвестна, и персонаж поднимается в точке привязки
    "RegionDataDirectory": "",

    // Территории мира: точка подъёма павшего и города территории. Цвет - метка территории
    // на слое регионов. Соответствует STerritoryInfo оригинала
    "Territories":
