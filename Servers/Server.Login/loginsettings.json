{
  "LoginSetting": {
    "Id": 100,
    // Адрес прослушивания; он же ключ, по которому канал ищется в TblParmSvr.
    // Порт берётся только из TblParmSvr.mTcpPort, в конфиге его нет
    "ServerIp": "127.0.0.1",

    // Сборка клиента, которую принимает канал. Ноль выключает проверку - значение лежит
    // в файлах клиента, и неверное здесь отказало бы всем входам «неверной версией»
    "ClientVersion": 0,

    // Предельные длины логина и пароля. Оригинал берёт их от страны сервера; двадцать -
    // то, что он использует везде, кроме Кореи и Китая
    "MaxLoginLength": 20,
    "MaxPasswordLength": 20,

    // Сколько игроков держит канал. Уходит серверам мира в пакете состояния
    "MaxSessions": 1000,

    // Как часто, в секундах, канал пингует связи серверов мира и рассылает своё состояние
    "FamilyKeepAliveSeconds": 30,

    // Шкала заполненности сервера в списке: ступени считаются по числу игроков, о котором
    // сервер сам сообщил каналу. Ниже первой ступени сервер показан самым свободным,
    // выше второй - загруженным, а когда свободных мест осталось меньше запаса - полным
    "ServerLowLoadSessions": 500,
    "ServerNormalLoadSessions": 1500,
    "ServerFullReserveSessions": 550,

    // Шифровать ли исходящие пакеты: включено - crypt-байт 0x01 и тело кадра под тем же
    // поточным шифром, что и на приёме; welcome-пакет уходит открытым в любом случае, он же
    // и несёт клиенту ключевой блок. По умолчанию выключено - живой клиент принимает
    // открытый текст, а приёмка шифрования на нём ещё не пройдена: возможно, для направления
    // сервер -> клиент нужен ключ из welcome-блока, а не статический
    "EncryptOutgoingPackets": false,

    // Генерировать ли ключевой блок welcome-пакета: включено - блок той же длины и раскладки,
    // но с новой ключевой частью на каждое подключение. По умолчанию выключено - живой клиент
    // видел только заготовленный блок, а приёмка генерации на нём ещё не пройдена
    "GenerateSessionKey": false
  }
}
